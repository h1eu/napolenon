{
  "_doc": "Quy ước máy đọc được cho conform.py. Glob dùng fnmatch, '*' và '**' đều khớp qua '/'. Mỗi rule phải có một dòng trong conventions.md mang nhãn [rule: <id>] — kiểm bằng: conform.py --coverage. Xoá rule mẫu không dùng.",
  "exclude": ["*.g.dart", "*.freezed.dart", "*.config.dart", "<lib>/l10n/gen/**", "**/generated/**"],
  "rules": [
    {
      "id": "no-ui-in-domain",
      "type": "forbidden-import",
      "in": "<lib>/**/domain/**",
      "forbid": ["package:flutter/**", "androidx.compose.**", "SwiftUI"]
    },
    {
      "id": "no-data-from-presentation",
      "type": "forbidden-import",
      "in": "<lib>/**/presentation/**",
      "forbid": ["*/data/*"]
    },
    {
      "id": "no-cross-feature",
      "type": "no-sibling-import",
      "base": "<lib>/features",
      "allow": []
    },
    {
      "id": "state-holder-suffix",
      "type": "naming",
      "in": "<lib>/**/*_bloc.dart",
      "class_regex": ".*(Bloc|Event|State)$"
    },
    {
      "id": "repo-impl-in-data",
      "type": "location",
      "pattern": "*_repository_impl.dart",
      "must_be_under": "<lib>/"
    },
    {
      "id": "max-400-lines",
      "type": "max-lines",
      "in": "<lib>/**",
      "max": 400
    },
    {
      "id": "max-function-lines",
      "type": "max-function-lines",
      "in": "<lib>/**",
      "max": 40
    },
    {
      "id": "max-params",
      "type": "max-params",
      "in": "<lib>/**",
      "max": 5,
      "constructors": false
    },
    {
      "id": "no-hardcoded-color",
      "type": "forbidden-pattern",
      "in": "<lib>/**",
      "regex": "Color\\(0x",
      "allow": ["<lib>/core/theme/**"],
      "skip_strings": true,
      "message": "màu phải lấy từ theme, không viết mã màu tại chỗ"
    },
    {
      "id": "few-comments",
      "type": "max-comment-ratio",
      "in": "<lib>/**",
      "max_ratio": 0.15,
      "min_lines": 20
    },
    {
      "id": "manager-suffix",
      "type": "naming",
      "in": "<lib>/**/*_manager.dart",
      "class_regex": ".*(Manager|Runtime)$"
    },
    {
      "id": "manager-not-in-presentation",
      "type": "location",
      "pattern": "*_manager.dart",
      "must_be_under": "<lib>/core/"
    }
  ]
}
